{
  "name": "my-backend",
  "version": "1.0.0",
  "description": "Express.js TypeScript REST API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build src/server.ts --target=bun --outdir=dist",
    "start": "bun dist/server.js",
    "check": "vp check",
    "test": "vp test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "auth:generate": "bunx @better-auth/cli generate --config src/lib/auth.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "@scalar/express-api-reference": "^0.9.14",
    "better-auth": "^1.6.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "swagger-jsdoc": "^6.2.8",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.9",
    "@types/swagger-jsdoc": "^6.0.4",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.0.0",
    "prisma": "^5.15.0",
    "typescript": "^5.5.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
